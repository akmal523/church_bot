# Copy to .env and fill in your real values
# cp .env.example .env

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string
# Local:  postgresql+asyncpg://postgres:password@localhost:5432/orthodox_bot
# Docker: postgresql+asyncpg://postgres:password@db:5432/orthodox_bot
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/orthodox_bot

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=[123456789]

# Google Maps API key (optional)
GOOGLE_MAPS_API_KEY=

# Cooldown between user questions in hours
QUESTION_COOLDOWN_HOURS=24

# --- Docker Compose variables ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=orthodox_bot
